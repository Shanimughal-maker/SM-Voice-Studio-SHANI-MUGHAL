# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# APP_PASSCODE: The secret passcode required to unlock the web app.
APP_PASSCODE="Shani Mughal From Sargodha"

# SESSION_SECRET: Secret key used to sign and verify session unlock tokens
SESSION_SECRET="your_random_session_secret_key"

# ADMIN_EMAIL: Verified admin email address (defaults to chromebook160nb@gmail.com)
ADMIN_EMAIL="chromebook160nb@gmail.com"

# FIREBASE_SERVICE_ACCOUNT_KEY: Optional JSON string of a Firebase service account private key.
# In Google AI Studio and Cloud Run, the app automatically uses Application Default Credentials (ADC).
# If running locally or in an environment without ADC, paste your service account JSON here.
FIREBASE_SERVICE_ACCOUNT_KEY=""
