{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and speech generation quota tracking",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address",
          "maxLength": 256
        },
        "plan": {
          "type": "string",
          "enum": ["free", "threeday", "monthly", "quarterly", "pro_monthly", "pro_3months", "lifetime"],
          "description": "Subscription plan tier",
          "maxLength": 32
        },
        "charactersUsed": {
          "type": "number",
          "description": "Total characters used by the user"
        },
        "planWordsUsed": {
          "type": "number",
          "description": "Total words used during the current 3-Day plan period"
        },
        "freeLimit": {
          "type": "number",
          "description": "Maximum characters allowed under free plan"
        },
        "planExpiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when paid plan expires (or null for free/lifetime)"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the user document was created"
        }
      },
      "required": ["email", "plan", "charactersUsed", "freeLimit", "createdAt"]
    },
    "License": {
      "title": "License",
      "description": "Subscription license keys for pro and lifetime access",
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "Unique license key string",
          "maxLength": 64
        },
        "plan": {
          "type": "string",
          "enum": ["threeday", "monthly", "quarterly", "lifetime"],
          "description": "Plan activated by this license key"
        },
        "status": {
          "type": "string",
          "enum": ["unused", "active", "revoked"],
          "description": "Redemption status of this key"
        },
        "redeemedBy": {
          "type": "string",
          "description": "UID of the user who redeemed this license (or null)",
          "maxLength": 128
        },
        "redeemedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the license was redeemed"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the license was generated"
        }
      },
      "required": ["key", "plan", "status", "createdAt"]
    },
    "PaymentRequest": {
      "title": "PaymentRequest",
      "description": "Manual payment request submitted by customer",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "UID of customer submitting payment",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of customer",
          "maxLength": 256
        },
        "plan": {
          "type": "string",
          "enum": ["threeday", "monthly", "quarterly", "lifetime"],
          "description": "Plan requested",
          "maxLength": 32
        },
        "amountUSD": {
          "type": "number",
          "description": "Amount in USD"
        },
        "amountPKR": {
          "type": "number",
          "description": "Amount in PKR"
        },
        "method": {
          "type": "string",
          "description": "Payment method used",
          "maxLength": 64
        },
        "senderName": {
          "type": "string",
          "description": "Name on sending account",
          "maxLength": 128
        },
        "senderNumber": {
          "type": "string",
          "description": "Account number or mobile number sending payment",
          "maxLength": 64
        },
        "transactionId": {
          "type": "string",
          "description": "Transaction ID (TID) from bank receipt",
          "maxLength": 128
        },
        "screenshotUrl": {
          "type": "string",
          "description": "URL or base64 of payment screenshot",
          "maxLength": 2048
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Review status of request"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when payment was submitted"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when reviewed by admin"
        },
        "rejectionReason": {
          "type": "string",
          "description": "Reason given if rejected",
          "maxLength": 512
        }
      },
      "required": ["uid", "plan", "amountUSD", "amountPKR", "method", "senderName", "senderNumber", "transactionId", "screenshotUrl", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "User profile with plan details and characters quota. Each user can read only their own document. Client cannot modify plan, charactersUsed, planWordsUsed, freeLimit, or planExpiresAt."
    },
    "/licenses/{licenseId}": {
      "schema": {
        "$ref": "#/entities/License"
      },
      "description": "License keys generated by admin. Readable and writable only by the admin."
    },
    "/paymentRequests/{requestId}": {
      "schema": {
        "$ref": "#/entities/PaymentRequest"
      },
      "description": "Manual payment requests submitted by users. Created with status 'pending' by owner, updated only by admin."
    }
  }
}
