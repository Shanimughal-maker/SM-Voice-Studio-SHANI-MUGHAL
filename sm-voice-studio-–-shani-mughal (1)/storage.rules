rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Payment screenshot uploads: image only, max 5MB, user's own directory
    match /payment_screenshots/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || (request.auth.token.email == 'chromebook160nb@gmail.com' && request.auth.token.email_verified == true));
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
