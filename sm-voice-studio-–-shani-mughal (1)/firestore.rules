rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Default Catch-All Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'chromebook160nb@gmail.com';
    }

    function isValidUserCreate(data, userId) {
      return isOwner(userId)
        && data.keys().hasAll(['email', 'plan', 'charactersUsed', 'freeLimit', 'createdAt'])
        && data.keys().hasOnly(['email', 'plan', 'charactersUsed', 'planWordsUsed', 'freeLimit', 'planExpiresAt', 'createdAt'])
        && data.email is string
        && data.plan == 'free'
        && data.charactersUsed == 0
        && (!('planWordsUsed' in data) || data.planWordsUsed == 0)
        && data.freeLimit == 10000
        && (data.createdAt is timestamp || data.createdAt == request.time)
        && (!('planExpiresAt' in data) || data.planExpiresAt == null);
    }

    // 2. Users Collection
    // Users can read only their own document (or admin).
    // Users can create their own document only with plan "free" and zero usage.
    // Users may read but NEVER update plan, planExpiresAt, planWordsUsed, charactersUsed or freeLimit.
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isValidUserCreate(request.resource.data, userId);
      allow update: if isAdmin()
        || (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'plan',
              'planExpiresAt',
              'planWordsUsed',
              'charactersUsed',
              'freeLimit'
            ])
        );
      allow delete: if false;
    }

    // 3. Licenses Collection
    // Licenses readable and writable ONLY by the admin
    match /licenses/{licenseId} {
      allow read, write: if isAdmin();
    }

    // 4. Payment Requests Collection
    // Created by owner (with status 'pending'), updated/deleted only by admin
    match /paymentRequests/{requestId} {
      allow get: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && (!('rejectionReason' in request.resource.data) || request.resource.data.rejectionReason == null)
        && (!('reviewedAt' in request.resource.data) || request.resource.data.reviewedAt == null);
      allow update, delete: if isAdmin();
    }

    // 5. Settings Collection (Pricing and Payment Methods)
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
